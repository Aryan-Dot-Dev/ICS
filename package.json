{
  "name": "ics-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "start": "bun dist/index.html --host=0.0.0.0:3000",
    "build": "bun run build:demo",
    "build:frontend": "bun run --cwd frontend build",
    "build:demo": "bun build.ts",
    "deploy:backend": "wrangler deploy --config wrangler.jsonc",
    "ingest-schemes": "bun run --cwd backend ingest-schemes",
    "serve:api": "bun run --cwd backend start",
    "typecheck": "bun run --cwd frontend typecheck && bun run --cwd backend typecheck",
    "test": "bun run --cwd backend test && bun run --cwd frontend test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1",
    "ogl": "^1.0.11",
    "react": "^19",
    "react-dom": "^19",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.11"
  }
}
