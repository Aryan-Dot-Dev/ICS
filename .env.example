[TEMPLATE]
# Backend environment variables (copy to .env for local development).
# Bun auto-loads .env when running `bun run serve:api`.

# --- Required: lead forwarding to the Google Sheets CRM --------------------
# Google Apps Script web-app intake endpoint. Every captured lead
# (assessment, chatbot, callback) is forwarded to the Sheet in addition to the
# local store in data/leads/. Find it in your Apps Script editor under
# Deploy > Manage deployments (the .../exec web-app URL of the intake script).
# The server refuses to start without it.
# LEAD_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Required: lead export auth --------------------------------------------
# Shared token required for the lead export endpoints:
#   GET /export            (CSV download — easiest for CRM imports)
#   GET /export.csv        (same, explicit extension)
#   GET /export?format=json
#   GET /api/leads/export  (canonical route)
#   GET /api/leads         (JSON lead list)
# Auth: ?token=... query param or "Authorization: Bearer ..." header.
# The server refuses to start without this token (lead PII protection).
# LEADS_EXPORT_TOKEN=change-me-to-a-long-random-string

# --- LLM extraction (optional) ---------------------------------------------
# When either key is set, requirement extraction uses the LLM path; otherwise
# the deterministic heuristic extractor is used.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Groq chat personalization (optional) ----------------------------------
# When GROQ_API_KEY is set, chatbot answers are personalized by a Groq LLM
# (https://console.groq.com/keys) on top of the deterministic recommendation
# engine: it rewrites the engine's grounded reply using the conversation
# history and collected profile. Engine facts, eligibility decisions and the
# template fallback are unchanged — if Groq is slow, misconfigured or errors,
# the chat silently falls back to the template reply.
# GROQ_API_KEY=
# Override the default model (openai/gpt-oss-120b) if needed:
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Chat rate limiting (optional) -----------------------------------------
# Per-client-IP token bucket on the chat endpoints, active only when
# GROQ_API_KEY is set (it protects the shared Groq quota). Defaults: bursts
# of 8 messages, then one message per 6 seconds. Tune for your traffic:
# CHAT_RATE_LIMIT_BURST=8
# CHAT_RATE_LIMIT_WINDOW_SECONDS=6

# --- Server -----------------------------------------------------------------
# PORT=8000
# NODE_ENV=production
