{
  "name": "ics-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "bun build.ts",
    "start": "bun dist/server.js",
    "worker:generate-data": "bun scripts/generate-worker-data.ts",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy --config ./wrangler.toml",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "ingest-schemes": "bun scripts/ingest-schemes.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/bun": "latest",
    "wrangler": "^4.147.0"
  }
}
